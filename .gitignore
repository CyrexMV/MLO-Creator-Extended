# what the program makes next to itself while it runs (your projects, exports, settings, caches, logs)
projects/
output/
Exports/
cache/
logs/
settings.json

# what build.ps1 and package.ps1 make (build them again from the source)
*.exe
*.exe.config
dist/

# editor / OS
.vs/
.vscode/
Thumbs.db
desktop.ini

# the live editor's sessions (projects sent to a server)
fivem/mlo_creator_live/data/*.json

# your own props (the props folder next to the program)
props/

# python caches
__pycache__/
